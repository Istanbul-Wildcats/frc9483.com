# Postgres connection string (local or Vercel Postgres / Neon / Supabase)
# On Vercel use the Supabase pooler (port 6543), e.g. postgres://USER.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/frc9483
# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.frc9483.com

# Vercel Blob token for media uploads (production only; unset locally = files stay in ./media)
BLOB_READ_WRITE_TOKEN=
